{
  "manifest_version": 3,
  "name": "Squirrel",
  "version": "1.0.0",
  "description": "Paste a link, pick a quality, and Squirrel saves it to your downloads folder.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Squirrel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["nativeMessaging", "activeTab", "contextMenus", "notifications"],
  "browser_specific_settings": {
    "gecko": {
      "id": "squirrel@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
