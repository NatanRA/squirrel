{
  "manifest_version": 2,
  "name": "Squirrel",
  "version": "1.0.0",
  "description": "Download videos and audio with the Squirrel app: click the button, or right-click any video or link.",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Download with Squirrel",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "permissions": ["nativeMessaging", "contextMenus", "activeTab"]
}
